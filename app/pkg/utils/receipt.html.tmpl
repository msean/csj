<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.5, user-scalable=yes"/>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:"WenQuanYi Micro Hei","Noto Sans CJK SC","PingFang SC","SimHei",sans-serif;font-size:14px;color:#111;background:#fff;padding:20px 16px;max-width:700px;margin:0 auto;}
.header-top{text-align:center;font-size:12px;color:#555;line-height:1.6;}
.title-main{text-align:center;font-size:22px;font-weight:bold;margin:8px 0 16px;}
.meta-row{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:4px;}
.meta-left{font-size:13px;color:#555;}
.customer-name{font-size:20px;font-weight:bold;margin:2px 0 8px;}
.meta-right{text-align:right;font-size:13px;}
.meta-right .serial{text-decoration:underline;font-weight:bold;}
.meta-right .date{text-decoration:underline;}
hr.thick{border:none;border-top:1.5px solid #111;margin:6px 0;}
hr.thin{border:none;border-top:0.5px solid #999;margin:4px 0;}
.table-wrapper{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:8px 0;}
table{width:100%;border-collapse:collapse;min-width:480px;}
table thead tr th{font-size:13px;color:#555;font-weight:normal;padding:4px 4px;white-space:nowrap;}
table thead tr th:nth-child(1){text-align:left;}
table thead tr th:nth-child(2){text-align:center;}
table thead tr th:nth-child(3){text-align:center;}
table thead tr th:nth-child(4){text-align:center;}
table thead tr th:nth-child(5){text-align:right;}
table tbody tr td{padding:6px 4px;font-size:14px;font-weight:bold;border-bottom:0.5px solid #ddd;}
table tbody tr td:nth-child(1){width:28%;}
table tbody tr td:nth-child(2){text-align:center;width:14%;}
table tbody tr td:nth-child(3){text-align:center;width:14%;}
table tbody tr td:nth-child(4){text-align:center;width:14%;}
table tbody tr td:nth-child(5){text-align:right;width:30%;}
table tfoot tr td{padding:6px 4px;font-size:14px;font-weight:bold;}
table tfoot tr td:nth-child(5){text-align:right;}
.spacer{height:32px;}
.summary{text-align:right;font-size:16px;margin:4px 0;}
.summary-row{display:flex;justify-content:flex-end;gap:32px;margin:4px 0;font-size:16px;}
hr.bold{border:none;border-top:2px solid #111;margin:8px 0;}
.bottom-bar{display:flex;justify-content:space-between;align-items:center;margin-top:4px;}
.prev-debt{font-size:18px;font-weight:bold;}
.total-debt{font-size:18px;font-weight:bold;}
.contact{font-size:12px;color:#333;margin-top:14px;line-height:1.8;}
.footer-brand{display:flex;align-items:center;gap:10px;margin-top:12px;border-top:1px solid #ccc;padding-top:10px;font-size:12px;color:#888;}
.footer-brand .logo-box{border:1.5px solid #999;padding:4px 8px;font-size:16px;font-weight:bold;color:#555;}

/* 三轮车费用行 */
.tricycle-fee-row td{white-space:nowrap;}

/* 订单分区：每单独立表格，订单间留空隙 */
.order-section{margin-bottom:28px;}
.order-section:last-child{margin-bottom:0;}
.order-meta{display:flex;justify-content:space-between;align-items:center;font-size:13px;color:#555;margin-bottom:4px;}
.order-meta strong{color:#111;}

/* ===== 移动端响应式 ===== */
@media screen and (max-width: 600px) {
  body{padding:14px 12px;font-size:13px;}
  .title-main{font-size:19px;margin:6px 0 12px;}
  .customer-name{font-size:17px;}
  .meta-left{font-size:12px;}
  .meta-right{font-size:12px;}
  .meta-row{flex-direction:column;gap:4px;}
  .meta-right{text-align:left;width:100%;}
  .table-wrapper{margin:6px 0;}
  table{min-width:400px;font-size:12px;}
  table thead tr th{font-size:11px;padding:3px 3px;}
  table tbody tr td{font-size:12px;padding:4px 3px;}
  table tfoot tr td{font-size:12px;padding:4px 3px;}
  table tbody tr td:nth-child(1){width:28%;}
  table tbody tr td:nth-child(2){width:14%;}
  table tbody tr td:nth-child(3){width:14%;}
  table tbody tr td:nth-child(4){width:14%;}
  table tbody tr td:nth-child(5){width:30%;min-width:50px;}
  .summary-row{font-size:14px;gap:20px;}
  .prev-debt,.total-debt{font-size:16px;}
  .spacer{height:20px;}
  .contact{font-size:11px;}
  .order-section{margin-bottom:20px;}
  .order-meta{font-size:12px;}
}

@media screen and (max-width: 420px) {
  body{padding:10px 8px;font-size:12px;}
  .title-main{font-size:17px;}
  .customer-name{font-size:15px;}
  .header-top{font-size:10px;}
  table{min-width:340px;font-size:11px;}
  table thead tr th{font-size:10px;padding:2px 2px;}
  table tbody tr td{font-size:11px;padding:3px 2px;}
  table tfoot tr td{font-size:11px;padding:3px 2px;}
  table tbody tr td:nth-child(1){width:30%;}
  table tbody tr td:nth-child(2){width:14%;}
  table tbody tr td:nth-child(3){width:14%;}
  table tbody tr td:nth-child(4){width:14%;}
  table tbody tr td:nth-child(5){width:28%;min-width:45px;}
  .summary-row{font-size:13px;gap:14px;flex-wrap:wrap;justify-content:flex-end;}
  .prev-debt,.total-debt{font-size:14px;}
  .bottom-bar{flex-wrap:wrap;gap:4px;}
  .spacer{height:16px;}
  .contact{font-size:10px;}
  .order-section{margin-bottom:16px;}
  .order-meta{font-size:11px;}
  hr.thick{margin:4px 0;}
  hr.thin{margin:3px 0;}
  hr.bold{margin:6px 0;}
}
</style>
</head>
<body>
<div class="header-top">
  <div>赊欠凭证</div>
  <div>广东省食用农产品批发市场销售票据</div>
</div>

<div class="title-main">{{.Title}}</div>

<div class="meta-row">
  <div>
    <div class="meta-left">客户:</div>
    <div class="customer-name">{{.CustomerName}}</div>
  </div>
</div>

<hr class="thick"/>

{{range $order := .Orders}}
<div class="order-section">
<div class="order-meta">
  <span>票号：<strong>{{$order.SerialNo}}</strong></span>
  <span>{{$order.Date}}</span>
</div>
<div class="table-wrapper">
<table>
  <thead>
    <tr>
      <th>货品</th>
      <th>数量</th>
      <th>重量</th>
      <th>单价</th>
      <th>小计</th>
    </tr>
  </thead>
  <tbody>
    {{range $g := $order.GoodsList}}
    <tr>
      <td>{{$g.GoodsName}}</td>
      <td>{{$g.MountStr}}</td>
      <td>{{if eq $g.GoodType 1}}--{{else}}{{$g.WeightStr}}{{end}}</td>
      <td>{{$g.PriceStr}}</td>
      <td>{{$g.TotalStr}}</td>
    </tr>
    {{end}}
  </tbody>
  <tfoot>
    {{if ne $order.TricycleFeeStr "0"}}
    <tr class="tricycle-fee-row">
      <td style="font-weight:bold;color:#555;">三轮车费</td>
      <td colspan="3"></td>
      <td style="text-align:right;font-weight:bold;">{{$order.TricycleFeeStr}}</td>
    </tr>
    {{end}}
    <tr>
      <td style="font-weight:bold;">合计</td>
      <td style="text-align:center;font-weight:bold;">{{$order.TotalMount}}</td>
      <td style="text-align:center;font-weight:bold;">{{$order.TotalWeight}}</td>
      <td></td>
      <td style="text-align:right;font-weight:bold;">{{$order.TotalAmountStr}}</td>
    </tr>
  </tfoot>
</table>
</div>
</div>
{{end}}

<hr class="thin"/>
<div class="spacer"></div>

<div class="summary-row">
  <span>本单赊欠：</span>
  <span>{{.CreditAmountStr}}</span>
</div>
<div class="summary-row">
  <span>前欠：</span>
  <span>{{.TotalPreviousCreditStr}}</span>
</div>

<hr class="bold"/>

<div class="bottom-bar">
  <div class="prev-debt">前欠: <strong>{{.TotalPreviousCreditStr}}</strong></div>
  <div class="total-debt">总欠: <strong>{{.TotalDebtStr}}</strong></div>
</div>

<hr class="thin"/>

<div class="contact">{{.Contact}}</div>

</body>
</html>